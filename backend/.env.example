# ===================================================================
# CareerForge Environment Configuration Template
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git!
# ===================================================================

# Application Server
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/careerforge_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=careerforge_user
DB_PASSWORD=your_secure_mysql_password_here

# JWT Configuration (Phase 2)
# JWT_SECRET=your_base64_encoded_256_bit_secret_key_here
# JWT_EXPIRATION_MS=86400000

# AI / LLM Configuration (Phase 6)
# OPENAI_API_KEY=your_openai_api_key_here
