# ===================================================================
# CareerForge Platform - Environment Configuration Template
# Duplicate this file to .env before starting the container stack.
# ===================================================================

# Database Credentials
DB_ROOT_PASSWORD=careerforge_root_pass
DB_NAME=careerforge_db
DB_USER=careerforge_user
DB_PASSWORD=careerforge_secure_pass
DB_PORT=3306

# Spring Security & JWT Configuration
# Must be a 256-bit (or 384-bit) Hex-encoded secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Google Gemini Generative AI Configuration
# Provide your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Bucket4j Rate Limiting Limits
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AI_CAPACITY=5
RATE_LIMIT_GENERAL_CAPACITY=100

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=80
